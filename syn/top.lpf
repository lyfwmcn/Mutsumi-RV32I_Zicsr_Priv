IOBUF  PORT "sdram_a[12]" IO_TYPE=LVCMOS33;

LOCATE COMP "sdram_dq[0]"  SITE "F16";
LOCATE COMP "sdram_dq[1]"  SITE "E15";
LOCATE COMP "sdram_dq[2]"  SITE "F15";
LOCATE COMP "sdram_dq[3]"  SITE "D14";
