LOCATE COMP "sdram_dm[0]" SITE "C16";
LOCATE COMP "sdram_dm[1]" SITE "T15";
IOBUF  PORT "sdram_dm[0]" IO_TYPE=LVCMOS33;
IOBUF  PORT "sdram_dm[1]" IO_TYPE=LVCMOS33;

// UART (iCELink CDC)
LOCATE COMP "uart_tx" SITE "B9";
IOBUF  PORT "uart_tx" IO_TYPE=LVCMOS33;

// UART RX（主机 -> FPGA），A9
LOCATE COMP "uart_rx" SITE "A9";
IOBUF  PORT "uart_rx" IO_TYPE=LVCMOS33;
