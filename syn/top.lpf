// iCESugar Pro (LFE5U-25F-6BG256C)

LOCATE COMP "clk" SITE "P6";
IOBUF  PORT "clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 25 MHZ;

LOCATE COMP "led_r" SITE "B11";
IOBUF  PORT "led_r" IO_TYPE=LVCMOS33;

LOCATE COMP "led_g" SITE "A11";
IOBUF  PORT "led_g" IO_TYPE=LVCMOS33;

LOCATE COMP "led_b" SITE "A12";
IOBUF  PORT "led_b" IO_TYPE=LVCMOS33;

// ---- SDRAM (IS42S16160B, 32MB) ----
LOCATE COMP "sdram_clk" SITE "R15";
IOBUF  PORT "sdram_clk" IO_TYPE=LVCMOS33;

LOCATE COMP "sdram_cke" SITE "L16";
IOBUF  PORT "sdram_cke" IO_TYPE=LVCMOS33;

LOCATE COMP "sdram_cs_n" SITE "A14";
IOBUF  PORT "sdram_cs_n" IO_TYPE=LVCMOS33;

LOCATE COMP "sdram_ras_n" SITE "B16";
IOBUF  PORT "sdram_ras_n" IO_TYPE=LVCMOS33;

LOCATE COMP "sdram_cas_n" SITE "G16";
IOBUF  PORT "sdram_cas_n" IO_TYPE=LVCMOS33;

LOCATE COMP "sdram_we_n" SITE "A15";
IOBUF  PORT "sdram_we_n" IO_TYPE=LVCMOS33;

LOCATE COMP "sdram_ba[0]" SITE "G15";
LOCATE COMP "sdram_ba[1]" SITE "B14";
IOBUF  PORT "sdram_ba[0]" IO_TYPE=LVCMOS33;
IOBUF  PORT "sdram_ba[1]" IO_TYPE=LVCMOS33;

LOCATE COMP "sdram_a[0]"  SITE "H15";
